# ============================================================================
# Puca backend configuration
# Copy to `.env` and fill in real values. Never commit your real .env.
#
# Every variable the server reads is documented here (scripts/check-docs-
# consistency.mjs fails the lint if one is added to src/ without a line
# below). Commented-out lines show the built-in default.
# ============================================================================

# --- Core (required) -------------------------------------------------------

# PostgreSQL connection string. This default matches the local docker-compose
# Postgres for the README quick start. In production the role named here
# should OWN the database and nothing else (deploy/README.md creates `puca`:
# postgres://puca:<password>@127.0.0.1/puca); running the backend as the
# `postgres` superuser works but is not intended.
DATABASE_URL=postgres://postgres:postgres@localhost/puca

# JWT signing secret. REQUIRED in production and must be strong:
#   - at least 32 characters
#   - not a placeholder (must not contain the word "change")
# Generate one with:  openssl rand -hex 32
# In production (APP_ENV=production) the server REFUSES to boot with a
# weak/placeholder secret, because a guessable secret lets anyone forge logins.
# Changing it later logs every user out and invalidates every token in flight.
JWT_SECRET=change_me_generate_with_openssl_rand_hex_32

# Environment: "production" (or "prod") enables production safety checks.
# Anything else (or unset) is treated as development.
APP_ENV=development

# --- Network ---------------------------------------------------------------

# Port to listen on. deploy/ops/healthcheck.sh probes whatever you set here.
PORT=3000

# Bind address. Default 127.0.0.1 is correct behind a reverse proxy on the
# same host. Use 0.0.0.0 for containers / direct exposure.
BIND_ADDR=127.0.0.1

# Comma-separated list of allowed CORS origins. REQUIRED in production (the
# server refuses to boot without it). The desktop and mobile apps send their
# OWN origins, so list them too or every installed app is blocked while the
# web app keeps working:
#   https://chat.example.com,https://app.example.com,tauri://localhost,http://tauri.localhost,https://localhost,capacitor://localhost
# If unset outside production, ALL origins are allowed (fine for local dev).
# CORS_ORIGINS=https://chat.example.com,https://app.example.com,tauri://localhost,http://tauri.localhost,https://localhost,capacitor://localhost

# Public URL of the WEB APP. Used as the base of the links in password-reset
# and email-verification mail (`<APP_URL>/reset-password?token=...`), and
# advertised by GET /config so every client (desktop, Android, web) builds
# invite links as <APP_URL>/invite/<code>; unset, clients hand out the bare
# invite code instead of a link. Required as soon as SMTP below is configured:
# the mail default is http://localhost:5173, and every message would carry a
# link to the recipient's own machine.
# APP_URL=https://app.example.com
# APP_URL=https://app.example.com

# --- Database pool ---------------------------------------------------------
# Default 20 (src/main.rs). Leave it unset unless you have a reason; it was
# once shipped here as 5, which is the value that let a WebSocket burst stall
# every DB-backed request. Must stay below Postgres's own max_connections
# (default 100) minus headroom for psql, the nightly pg_dump and any second
# backend instance sharing the database.
# DATABASE_MAX_CONNECTIONS=20

# --- Logging ---------------------------------------------------------------

# tracing/env_logger filter.
RUST_LOG=puca=info,tower_http=warn

# --- Registration gate (RECOMMENDED before the server is reachable) --------
# When set (non-empty), new-account registration requires a matching invite
# code (checked server-side for every client: web, desktop, mobile). Unset or
# empty => registration is OPEN to anyone who can reach the origin, and each
# account carries a per-user storage entitlement (512 MB of attachments plus
# the clip budget below) with no global cap. Toggling this env var is the
# on/off switch; changing it invalidates every invite link already handed out.
# REGISTRATION_INVITE_CODE=your-shared-invite-code

# --- Auth rate limiting ----------------------------------------------------
# Protects /auth/* endpoints from brute force. Defaults apply if unset.
# AUTH_RATE_LIMIT_PER_SECOND=5
# AUTH_RATE_LIMIT_BURST=10

# --- Who the rate limiter thinks you are -----------------------------------
# Every per-IP limit (auth, API, WebSocket connections, file downloads) keys on
# the caller's address. A forwarding header is believed only when something
# vouches for it:
#   * X-Forwarded-For / X-Real-IP  - trusted automatically when the TCP peer is
#     loopback or a private address, i.e. the Caddy/nginx configs in deploy/,
#     both of which OVERWRITE X-Forwarded-For with the real peer.
#   * CF-Connecting-IP             - trusted only if you set the flag below.
# On a directly-exposed listener (BIND_ADDR=0.0.0.0, no proxy) no header is
# believed and the socket address is used, because the client sends them all.
#
# Leave this UNSET unless Cloudflare talks to this process directly. If you use
# deploy/cloudflare/caddy-behind-cloudflare.snippet you do NOT need it - that
# snippet validates Cloudflare's ranges and rewrites X-Forwarded-For itself.
# Turning it on without an origin firewall lets anyone re-key themselves per
# request, which disables the auth limiter entirely.
# TRUST_CF_CONNECTING_IP=true

# --- Per-IP concurrency ceilings (optional) --------------------------------
# All defaults are sized for a friends-scale server behind one NAT. Raise them
# for a large shared-NAT site (a campus, an office); lower them on a small
# uplink.
# Concurrent WebSocket connections per real client IP (on top of the per-user
# cap). Default 64.
# WS_MAX_CONNS_PER_IP=64
# Seconds of silence before a WebSocket is reaped. Must stay comfortably above
# the client's 30 s heartbeat or a briefly-backgrounded phone is kicked out of
# voice. Default 75.
# WS_IDLE_TIMEOUT_SECS=75
# Concurrent uploads per IP: each holds up to ~28 MiB in RAM while it lands.
# Default 8 (dragging five images onto the chat is ordinary use).
# UPLOAD_MAX_CONCURRENT_PER_IP=8
# Concurrent file downloads per IP (slow-drip streams each hold an fd and
# egress). Default 32.
# FILE_MAX_CONCURRENT_PER_IP=32

# --- Retention (optional) --------------------------------------------------
# Resolved reports and audit-log rows older than these windows are pruned
# every 6 hours (pending reports never). 0 = keep that table forever, for an
# operator with a compliance need. Deleting moderation history is
# irreversible, so the defaults are generous.
# REPORTS_RETENTION_DAYS=180
# AUDIT_RETENTION_DAYS=365
# Posted clips (docs/CLIPS.md): days a posted clip lives before the sweep
# removes it. Unset, unparsable or negative = keep forever; Settings > Clips
# shows users whatever this says. Per-user clip storage budget in bytes
# (default 2 GiB, separate from the 512 MB attachment budget), and the sweep
# interval in seconds (default 3600; the first sweep runs 5 minutes after boot).
# CLIP_RETENTION_DAYS=
# CLIP_MAX_USER_BYTES=2147483648
# CLIP_SWEEP_INTERVAL_SECS=3600
# See also DELETED_ACCOUNT_FILE_GRACE_DAYS at the end of this file.

# --- File capabilities (optional) ------------------------------------------
# Attachments uploaded by 0.8.134+ clients carry a per-file capability that
# the client presents when fetching (request header X-Puca-File-Cap). The
# server stores only its SHA-256, so it still never learns which channel a
# file belongs to. Phase 1 (the default): a capability is CHECKED when one is
# presented, not required, so older clients keep fetching. Phase 2: set this
# to 1 once every client in the field is 0.8.134+, and a file that has a
# capability is served only to a caller presenting it. Files without one
# (older uploads, avatars, icons, sounds, emoji, clip parts) are never gated.
# FILES_ENFORCE_CAP=1

# --- STUN (WebRTC address discovery) ---------------------------------------
# Comma-separated STUN URLs handed to clients for NAT traversal. This REPLACES
# the default rather than adding to it, and may be set empty to use none at all.
#
# You usually do not need to set this. The default is:
#   * TURN_SERVER below, if you set one — coturn answers STUN on the same host
#     and port, so address discovery stays on infrastructure you control;
#   * otherwise Google's public STUN servers, as a last resort, because without
#     STUN peer-to-peer calls fail behind NAT and most self-hosters have no
#     alternative to hand.
#
# Why it matters: a STUN server is asked "what is my public address?", so it
# necessarily learns the client's IP and port and the timing of every call
# setup. It never sees media, and it does not learn who is being called. Running
# your own TURN removes even that disclosure.
# STUN_SERVERS=stun:turn.example.com:3479
#
# Media itself never traverses a STUN server; it is address discovery only.
# To keep participants from learning each other's IPs at all, users can enable
# "Hide my IP in calls (relay only)" in Settings, which forces media via TURN.

# --- WebRTC TURN (REQUIRED for calls across the internet) ------------------
# There is NO third-party relay fallback: with these unset, two peers who both
# sit behind symmetric NAT or CGNAT simply never connect, with no error beyond
# a call that stays "connecting". Run coturn (deploy/turn/README.md) and point
# the clients at it. The port is whatever deploy/turn/turnserver.conf listens
# on (3479 as shipped); list the udp and tcp forms so a client behind a
# UDP-hostile firewall still gets a relay. The backend mints 4-hour HMAC
# credentials from TURN_SECRET (coturn's static-auth-secret), so the relay is
# never open to strangers. Use the relay's OWN hostname, DNS-only if you use a
# CDN: UDP cannot be proxied.
# TURN_SERVER=turn:turn.example.com:3479?transport=udp,turn:turn.example.com:3479?transport=tcp
# TURN_SECRET=your_turn_shared_secret

# --- Email / SMTP (optional; enables password reset + verification) --------
# All four (HOST, USERNAME, PASSWORD, FROM) must be set to enable email. Set
# APP_URL above at the same time, or the mail links point at localhost.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=postmaster@example.com
# SMTP_PASSWORD=your_smtp_password
# SMTP_FROM=no-reply@example.com

# --- Tier-2 SFU (optional; LiveKit-backed multi-streaming voice channels) ---
# All three LIVEKIT_* vars must be set to enable the SFU tier; unset = the
# /channels/:id/sfu-token endpoint answers 503 and mesh calls are unaffected.
# Set-but-down is NOT detected here: the backend mints join tokens from these
# values alone, so keep the livekit unit running (deploy/ops/healthcheck.sh
# supervises it once enabled). Setup: deploy/livekit/README.md
# LIVEKIT_URL=wss://sfu.example.com
# LIVEKIT_API_KEY=puca-sfu
# LIVEKIT_API_SECRET=same_secret_as_livekit_yaml_min_32_chars
# Node-global egress ceiling (Mbps) across ALL SFU rooms; joins are refused
# past it. Default 30. Size to the uplink with bufferbloat headroom.
# Admission is hybrid: worst-case projection first, and when that would
# refuse, a fresh MEASURED egress sample (see SFU_METRICS_URL) may still
# admit — so watching being opt-in doesn't strand unused capacity.
# SFU_EGRESS_BUDGET_MBPS=30
# SFU_ROOM_MAX_PARTICIPANTS=8
# Concurrent screen shares per room. Unset or 0 = unlimited (the egress
# budget still governs admission). Set a number to re-cap.
# SFU_MAX_SCREEN_SHARES=0
# LiveKit Prometheus endpoint for the measured-egress sampler. Default
# http://127.0.0.1:6789/metrics (requires prometheus_port: 6789 in
# livekit.yaml); set to "off" to disable. Unreachable/stale metrics simply
# fall back to worst-case-only admission.
# SFU_METRICS_URL=http://127.0.0.1:6789/metrics

# --- Update manifests (optional) --------------------------------------------
# Three small JSON files the operator drops next to the binary when publishing
# a release (deploy/ops/dual-ship.sh writes them; no rebuild or restart). All
# paths resolve RELATIVE TO THE SERVICE WORKING DIRECTORY (/opt/puca in the
# packaged deployment) — a copy under the download site's directory is a
# different file that nothing reads. Verify through the endpoint, not the file.
#
# The desktop app polls GET /app-version to decide whether to offer an update:
#   { "version": "0.9.0", "download_url": "https://download.example.com/", "notes": "..." }
# APP_VERSION_FILE=app-version.json
# The mobile app polls GET /api/mobile-updates/check (the ONLY route under
# /api/ — proxy the whole origin) for the signed OTA manifest; the Lite build
# asks with ?variant=lite and gets the second file. Leave both unset: dual-
# ship.sh writes exactly these names.
# MOBILE_UPDATE_FILE=mobile-update.json
# MOBILE_UPDATE_FILE_LITE=mobile-update-lite.json

# --- Wake signals (optional; Android doorbell via FCM) ----------------------
# BOTH vars or neither. The signal is the CONSTANT {"w":"1"} — the server test
# suite pins the entire serialised body, so what crosses Google is a device
# token, the app id, and timing. Never a name, an id, or content: those flow
# over the app's own native socket, which this signal merely reconnects
# through Doze. Unset = doorbell off; the native socket alone carries delivery
# (screen-off gaps possible without a battery exemption) and
# /notifications/test answers 501. Set-but-broken aborts the boot.
# FCM_PROJECT_ID=your-firebase-project-id
# FCM_SERVICE_ACCOUNT_FILE=/opt/puca/fcm-service-account.json

# How many days a DELETED account's uploads (attachments, avatar, sounds, clip
# parts) stay before the retention sweep removes them. Their ids live inside
# other people's end-to-end encrypted messages, so the server cannot warn the
# channels they were shared in: the grace period is the warning. Server icons
# and custom emoji the account uploaded belong to the server and are kept.
# 0 = purge at the next sweep.
DELETED_ACCOUNT_FILE_GRACE_DAYS=30

# Per-user attachment storage quota in bytes (default 512 MiB). Clip parts
# have their own quota (CLIP_MAX_USER_BYTES).
UPLOAD_MAX_USER_BYTES=536870912

# Where the source code of THIS server build can be obtained (AGPL §13: a
# network user is entitled to the source of the version they interact with).
# GET /source answers with this URL and the commit the binary was built from.
# A fork MUST point this at its own repository.
SOURCE_URL=https://github.com/Fossferous/Puca

# --- Test harness and legacy switches (leave unset in production) ----------
# CLIP_PROPOSAL_TTL_SECS shortens the 30-minute clip-approval window so the
# live e2e can drive expiry without sleeping; production never sets it.
# CLIP_PROPOSAL_TTL_SECS=1800
# ALLOW_MIGRATION_PASSWORD_RESET=true re-enables a one-time legacy reset path
# (force_password_reset accounts) that lets anyone who knows such a username
# take the account over. Superseded by /auth/recovery/* and email reset;
# enable only for a migration window on a server you are watching, then unset.
# ALLOW_MIGRATION_PASSWORD_RESET=false

# Seconds a dropped voice socket may be silent before the room is told the
# user left. A reconnect inside the window is never announced at all (no
# leave/join chimes for a network blip). Default 8; 0 announces at once.
WS_REJOIN_GRACE_SECS=8
