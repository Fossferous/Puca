# ============================================================================
# Puca backend configuration
# Copy to `.env` and fill in real values. Never commit your real .env.
# ============================================================================

# --- Core (required) -------------------------------------------------------

# PostgreSQL connection string.
DATABASE_URL=postgres://postgres:postgres@localhost/puca

# JWT signing secret. REQUIRED in production and must be strong:
#   - at least 32 characters
#   - not a placeholder (must not contain the word "change")
# Generate one with:  openssl rand -hex 32
# In production (APP_ENV=production) the server REFUSES to boot with a
# weak/placeholder secret, because a guessable secret lets anyone forge logins.
JWT_SECRET=change_me_generate_with_openssl_rand_hex_32

# Environment: "production" (or "prod") enables production safety checks.
# Anything else (or unset) is treated as development.
APP_ENV=development

# --- Network ---------------------------------------------------------------

# Port to listen on.
PORT=3000

# Bind address. Default 127.0.0.1 is correct behind a reverse proxy on the
# same host. Use 0.0.0.0 for containers / direct exposure.
BIND_ADDR=127.0.0.1

# Comma-separated list of allowed CORS origins, e.g.
#   https://app.example.com,https://example.com
# If unset, ALL origins are allowed (fine for local dev, INSECURE in prod).
# CORS_ORIGINS=https://app.example.com

# Public base URL of the deployment (used in email links / embeds).
# PUBLIC_BASE_URL=https://app.example.com
# APP_URL=https://app.example.com

# --- Database pool ---------------------------------------------------------

DATABASE_MAX_CONNECTIONS=5

# --- Logging ---------------------------------------------------------------

# tracing/env_logger filter.
RUST_LOG=puca=info,tower_http=warn

# --- Auth rate limiting ----------------------------------------------------
# Protects /auth/* endpoints from brute force. Defaults apply if unset.
# AUTH_RATE_LIMIT_PER_SECOND=5
# AUTH_RATE_LIMIT_BURST=10

# --- Registration gate (optional) ------------------------------------------
# When set (non-empty), new-account registration requires a matching invite
# code (checked server-side for every client: web, desktop, mobile). Unset or
# empty => registration is open. Toggling this env var is the on/off switch.
# REGISTRATION_INVITE_CODE=your-shared-invite-code

# --- Email / SMTP (optional; enables password reset + verification) --------
# All four (HOST, USERNAME, PASSWORD, FROM) must be set to enable email.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=postmaster@example.com
# SMTP_PASSWORD=your_smtp_password
# SMTP_FROM=no-reply@example.com

# --- WebRTC TURN (optional; improves voice/video NAT traversal) ------------
# TURN_SERVER=turn:turn.example.com:3478
# TURN_SECRET=your_turn_shared_secret

# --- Tier-2 SFU (optional; LiveKit-backed multi-streaming voice channels) ---
# All three LIVEKIT_* vars must be set to enable the SFU tier; unset = the
# /channels/:id/sfu-token endpoint answers 503 and mesh calls are unaffected.
# Setup: deploy/livekit/README.md
# LIVEKIT_URL=wss://sfu.example.com
# LIVEKIT_API_KEY=puca-sfu
# LIVEKIT_API_SECRET=same_secret_as_livekit_yaml_min_32_chars
# Node-global egress ceiling (Mbps) across ALL SFU rooms; joins are refused
# past it. Default 30. Size to the uplink with bufferbloat headroom.
# Admission is hybrid: worst-case projection first, and when that would
# refuse, a fresh MEASURED egress sample (see SFU_METRICS_URL) may still
# admit — so watching being opt-in doesn't strand unused capacity.
# SFU_EGRESS_BUDGET_MBPS=30
# SFU_ROOM_MAX_PARTICIPANTS=8
# Concurrent screen shares per room. Unset or 0 = unlimited (the egress
# budget still governs admission). Set a number to re-cap.
# SFU_MAX_SCREEN_SHARES=0
# LiveKit Prometheus endpoint for the measured-egress sampler. Default
# http://127.0.0.1:6789/metrics (requires prometheus_port: 6789 in
# livekit.yaml); set to "off" to disable. Unreachable/stale metrics simply
# fall back to worst-case-only admission.
# SFU_METRICS_URL=http://127.0.0.1:6789/metrics

# --- Desktop update prompt (optional) ---------------------------------------
# The desktop app polls GET /app-version; publish a release by writing this
# JSON file next to the binary (no rebuild/restart needed):
#   { "version": "0.5.40", "download_url": "https://download.example.com/Puca-Setup.exe", "notes": "..." }
# APP_VERSION_FILE=app-version.json


# --- Wake signals (optional; Android doorbell via FCM) ----------------------
# BOTH vars or neither. The signal is the CONSTANT {"w":"1"} — the server test
# suite pins the entire serialised body, so what crosses Google is a device
# token, the app id, and timing. Never a name, an id, or content: those flow
# over the app's own native socket, which this signal merely reconnects
# through Doze. Unset = doorbell off; the native socket alone carries delivery
# (screen-off gaps possible without a battery exemption) and
# /notifications/test answers 501. Set-but-broken aborts the boot.
# FCM_PROJECT_ID=your-firebase-project-id
# FCM_SERVICE_ACCOUNT_FILE=/opt/puca/fcm-service-account.json
