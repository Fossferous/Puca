<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ twin of backup_rules.xml — see the rationale there. Device
     transfer is treated exactly like cloud backup: a new phone signs in and
     derives its own keys and its own session; it must not inherit this one's
     token or identity. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="backup-nothing-placeholder" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="backup-nothing-placeholder" />
    </device-transfer>
</data-extraction-rules>
