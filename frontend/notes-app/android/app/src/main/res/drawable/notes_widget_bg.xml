<?xml version="1.0" encoding="utf-8"?>
<!-- A fixed surface: a widget is drawn by the launcher and cannot follow the
     app's eight themes or [data-contrast="high"]. Matches the Notes shell's
     dark background, slightly translucent so the wallpaper reads through,
     with the large corner radius launchers expect. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#F21A1A2E" />
    <corners android:radius="24dp" />
</shape>
