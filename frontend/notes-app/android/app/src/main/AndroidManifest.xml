<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- "Take photo" (a note's camera button, <input accept="image/*" capture>).
         The WebView's file chooser opens the camera only if
         ACTION_IMAGE_CAPTURE resolves to an app, and from Android 11 that
         lookup sees nothing this manifest does not declare it queries —
         without this the button quietly falls back to the file picker. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <!-- allowBackup=false, for the same reason as the Púca app: the WebView
         profile (app_webview) holds the E2EE identity seed and the session
         token, and Auto Backup / device-to-device transfer would copy it to
         Google's backup service. Nothing needs backing up — a device
         re-derives its state by signing in. The reminder store now also holds
         a copy of the session token (the background refresh), so the
         include-only rule files are carried too, as in Púca: re-enabling
         backup later still copies nothing. requestLegacyExternalStorage lets
         Android 10 write an export into Documents (ignored from 11 on). -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="${notesCleartext}"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Share INTO Púca Notes: the composer opens pre-filled and the
                 user presses Done (or does not). Nothing is saved for them.

                 What arrives here is decrypted note content, so the intake
                 (NotesNativePlugin.takeShare) copies it once, hands it to the
                 WebView, and erases it: no SharedPreferences, no ReminderStore,
                 no notification, and NEVER a Log call — printing the intent
                 would put what the user shared into logcat.

                 No <uses-permission> goes with this: reading a content:// URI
                 the sharer granted needs none. MainActivity is already
                 singleTask, so a share while Notes runs re-enters the same
                 task through onNewIntent. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <!-- Long-press-the-icon shortcuts. MUST sit on the activity that
                 owns MAIN/LAUNCHER — on the application element or any other
                 activity the launcher never registers them. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- The due-reminder alarm lands here. Not exported: only this app's
             own PendingIntent can reach it. -->
        <receiver
            android:name=".ReminderReceiver"
            android:exported="false" />

        <!-- Re-arms after a reboot, an update, a clock or time-zone change,
             or the exact-alarm grant changing. Exported because system
             broadcasts must reach it; each action is protected (or, for
             MY_PACKAGE_REPLACED, delivered only to this app). -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- The ~hourly reminder-feed refresh while Notes is closed. Only the
             system's job scheduler may bind it. -->
        <service
            android:name=".ReminderRefreshJob"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />

        <!-- Púca asks here whether Notes owns due-item reminders on this
             phone (one row, 1 or 0; ReminderOwnerProvider). Exported, but
             only to an app holding DUE_REMINDER_OWNER below, which Android
             grants solely to an app signed with the same key: Púca. -->
        <provider
            android:name=".ReminderOwnerProvider"
            android:authorities="com.sovereign.notes.reminderowner"
            android:exported="true"
            android:permission="com.sovereign.notes.permission.DUE_REMINDER_OWNER" />

        <!-- Location reminders: type location ONLY, running exactly while
             there are saved-place fences and a location grant. -->
        <service
            android:name=".NotesGeofenceService"
            android:foregroundServiceType="location"
            android:exported="false" />

        <!-- The quick-settings tile: "New note", straight from the shade.
             exported=true because only the SYSTEM binds a tile service, and
             the BIND_QUICK_SETTINGS_TILE permission is what makes that safe —
             the same shape as ReminderOwnerProvider above.

             The label is a compile-time constant (NotesTileService.LABEL).
             The shade is reachable over a locked screen on some phones, so it
             must never carry a count, a title or anything else from a note. -->
        <service
            android:name=".NotesTileService"
            android:exported="true"
            android:icon="@drawable/ic_qs_new_note"
            android:label="@string/tile_new_note"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Home-screen quick capture (new note / list / draw / photo).
             Exported because the launcher's APPWIDGET_UPDATE broadcast must
             reach it; that action is a protected broadcast only the system
             can send.

             RemoteViews are inflated, drawn and CACHED by the launcher
             process, so this widget carries four fixed labels and nothing
             else — no note title, no item count, no query into the note
             store. It is never polled (updatePeriodMillis 0). -->
        <receiver
            android:name=".NotesWidgetProvider"
            android:label="@string/widget_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/notes_widget_info" />
        </receiver>
    </application>

    <!-- Who may ask ReminderOwnerProvider: apps signed with the SAME key as
         Púca Notes, i.e. Púca (both release-sign with the Púca keystore;
         frontend/android/app/build.gradle and this app's build.gradle).
         Púca requests it with <uses-permission>. -->
    <permission
        android:name="com.sovereign.notes.permission.DUE_REMINDER_OWNER"
        android:protectionLevel="signature" />

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Due reminders (docs/NOTES.md, "The Android app"). Notifications are a
         runtime ask on 13+, from the Reminders view's banner. Exact alarms:
         USE_EXACT_ALARM on 13+ (granted at install; fine for a sideloaded
         reminder app, would need Play's declaration if Notes were ever listed
         there), SCHEDULE_EXACT_ALARM on 12-12L only. BOOT_COMPLETED re-arms
         the alarm and keeps the persisted refresh job. The battery exemption
         is asked from a banner, never on its own. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- The refresh job's "any network" constraint: JobScheduler refuses to
         schedule a job with a connectivity constraint without it (found on
         the emulator — a SecurityException, not a lint warning). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Location reminders (opt-in per phone, OFF by default). Coordinates
         never leave the device: fences are {taskId, lat, lon, r} in app
         prefs, evaluated on-device, no Play Services, no network call.
         BACKGROUND_LOCATION lets the watch start again after a reboot and is
         asked as Android requires (foreground first, then "Allow all the
         time"); FOREGROUND_SERVICE_LOCATION pairs with the service type. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Voice notes (docs/NOTES.md, "The Android app"). FOREGROUND ONLY: the
         microphone is held by the WebView's recorder while the recorder sheet
         is open and released when Púca Notes leaves the screen. There is no
         service and no FOREGROUND_SERVICE_MICROPHONE type, so nothing here can
         record with the app closed. Asked from the recorder AFTER a prominent
         disclosure. MODIFY_AUDIO_SETTINGS is declared because Capacitor's
         BridgeWebChromeClient requests it TOGETHER with RECORD_AUDIO for a
         WebView AUDIO_CAPTURE request — an undeclared one denies the whole
         request. Recordings are sealed on-device; a transcript, where the
         phone can make one ON-DEVICE, is made from a cache file that is
         deleted straight after (NotesNativePlugin.transcribePcm). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Export into Documents on Android 10 and older (11+ needs no grant for
         a file the app creates there). -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
</manifest>
