# The server URL the DESKTOP INSTALLER / production web build is compiled
# against — baked in at build time.
#
# Copy this file to `frontend/.env.production` and set it to YOUR server's
# public URL before running `npm run tauri:build` (or `npm run build`).
# Without it the build falls back to http://localhost:3000, which is only
# useful for local testing.
#
# `.env.production` itself is git-ignored so your domain never ends up in the
# repo — that's why this `.example` exists.
VITE_API_URL=https://chat.your-domain.com

# OPTIONAL, and only used by the UPDATE-CHECK paths.
#
# If a build somehow ships with the wrong VITE_API_URL, its update checks use
# that same wrong base — so it can never be offered the fix. That happened
# (v0.8.24/25: every client stranded until a manual reinstall). Setting this
# gives the update check a second base to try, which is safe because installers
# and OTA bundles are signature-verified regardless of where they came from.
#
# Leave it UNSET and there is simply no fallback — the configured base is tried
# and that is all. Never point it at someone else's deployment.
# VITE_UPDATE_FALLBACK_API=https://chat.your-domain.com
