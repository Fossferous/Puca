{
  "name": "frontend",
  "private": true,
  "version": "0.8.21",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:agent && tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint . && node scripts/check-no-ui-emoji.mjs",
    "lint:icons": "node scripts/check-no-ui-emoji.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "node scripts/build-agent.mjs && node scripts/tauri-build.mjs",
    "build:lite": "node scripts/build-lite.mjs",
    "check:no-rc": "node scripts/check-no-rc.mjs",
    "check:lite-identity": "node scripts/check-lite-identity.mjs",
    "tauri:build:lite": "node scripts/check-lite-identity.mjs && node scripts/build-lite.mjs && node scripts/tauri-build.mjs --no-default-features --config src-tauri/tauri.lite.conf.json",
    "cap:build:android:lite": "node scripts/check-lite-identity.mjs && node scripts/build-lite.mjs --sync android",
    "cap:build:ios:lite": "node scripts/check-lite-identity.mjs && node scripts/build-lite.mjs --sync ios",
    "cap:sync": "npx cap sync",
    "cap:ios": "npm run build && npx cap sync ios && npx cap open ios",
    "cap:android": "npm run build && npx cap sync android && npx cap open android",
    "cap:build:ios": "npm run build && npx cap sync ios",
    "cap:build:android": "npm run build && npx cap sync android",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "verify:e2ee": "node e2e/e2ee-live-verify.mjs",
    "build:agent": "node scripts/build-agent.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.0.0",
    "@capgo/capacitor-updater": "^8.3.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^2.0.1",
    "@sapphi-red/web-noise-suppressor": "^0.3.5",
    "@scure/bip39": "^1.6.0",
    "@tanstack/react-query": "^5.90.12",
    "@tauri-apps/api": "^2.9.1",
    "@tauri-apps/cli": "^2.9.5",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "livekit-client": "^2.21.0",
    "lodash-es": "^4.17.21",
    "mediabunny": "^1.55.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.11.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.3.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.0.16"
  }
}
