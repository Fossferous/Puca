<?xml version="1.0" encoding="utf-8"?>
<!-- Static shortcut row: 4x1 cells, horizontally resizable, never polled
     (updatePeriodMillis 0 — the content cannot go stale). targetCellWidth /
     previewLayout / description are API 31+ and ignored below. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="60dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:maxResizeHeight="120dp"
    android:resizeMode="horizontal"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/puca_widget"
    android:previewLayout="@layout/puca_widget"
    android:description="@string/widget_description"
    android:widgetCategory="home_screen" />
