<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ twin of backup_rules.xml — see the full rationale there.

     Backup and transfer are disabled outright by android:allowBackup="false",
     so these rules are not consulted today. They are kept and inverted to
     INCLUDE-ONLY so that re-enabling backup later cannot silently restore the
     old whole-data-directory behaviour, which carried the WebView profile
     (app_webview) and therefore the E2EE identity seed, the session JWT, the
     web device private key and remembered unattended-access seeds.

     device-transfer is treated exactly like cloud-backup here. A transfer
     target is a different device: it should log in and derive its own keys,
     not inherit the source device's identity material. -->
<data-extraction-rules>
    <cloud-backup>
        <!-- Intentionally empty: include-only with no real includes copies nothing. -->
        <include domain="root" path="backup-nothing-placeholder" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="backup-nothing-placeholder" />
    </device-transfer>
</data-extraction-rules>
